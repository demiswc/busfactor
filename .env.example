# busfactor configuration. Copy to .env and fill in. install.sh does this for you.

# Public address of the site (no trailing slash). Used in every email link.
APP_URL=https://busfactor.example.com

# MariaDB / MySQL connection.
DATABASE_URL=mysql://busfactor:CHANGE_ME@127.0.0.1:3306/busfactor

# 32 random bytes, base64: openssl rand -base64 32
# Encrypts names, email addresses and contact details at rest (and instructions saved without a
# passphrase). BACK IT UP: without it the database cannot be read.
APP_ENCRYPTION_KEY=

# Shared secret for the scheduler (at least 24 characters): openssl rand -hex 24
CRON_SECRET=

# Outgoing email (SMTP). Port 465 = implicit TLS, 587 = STARTTLS.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# If your password contains $ # quotes or spaces, use this instead: printf '%s' 'the-password' | base64
# SMTP_PASS_B64=
SMTP_FROM="busfactor <no-reply@busfactor.example.com>"
# Optional: certificate name to check when SMTP_HOST is an IP address.
# SMTP_TLS_SERVERNAME=mail.example.com

# Time zone used for dates in emails.
DEFAULT_TIMEZONE=Europe/London

# Shown on the privacy page.
OPERATOR_NAME=
OPERATOR_EMAIL=
# Accounts allowed to open /stats (counts and timings only, no personal data). Comma-separated.
# They also get a short stats email every Monday morning. Leave empty to turn both off.
OPERATOR_ADMIN_EMAILS=
# Set to "off" to keep the stats page but stop the weekly email.
OPERATOR_STATS_EMAIL=

# Allow "encrypted by this site" instructions (readable by the operator). Public services should set false,
# so users can only use passphrase-sealed instructions and personal messages the operator cannot read.
ALLOW_SERVER_INSTRUCTIONS=true

# Number of reverse proxies in front of the app (Caddy/nginx = 1; a CDN in front of those = 2).
# Used to find the real client address for rate limiting.
TRUST_PROXY_HOPS=1

# Optional: pinged after every scheduler run (healthchecks.io, Uptime Kuma push URL...) so you hear if it stops.
# HEALTHCHECK_PING_URL=

# Only for testing webhooks on your own network. Never enable on a public service.
# ALLOW_PRIVATE_WEBHOOKS=false

PORT=3000
